rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Validation landing sign-ups: anyone can create, nobody can read/update/delete from the client.
    match /signups/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'type', 'text', 'lang', 'source', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.type in ['problem', 'builder']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && request.resource.data.lang in ['en', 'el']
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 200
        && request.resource.data.createdAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
