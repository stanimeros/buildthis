rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    // Google accounts only, so enabling another provider later can't open vote farming.
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Signed in and not blocked by strikes (see moderation). Every action needs this.
    function active() {
      return signedIn() && inGoodStanding();
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function onboarded() {
      return signedIn() && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.onboardedAt != null;
    }

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function categories() {
      return ['productivity', 'finance', 'health', 'family', 'education', 'housing',
              'transport', 'food', 'social', 'work', 'other'];
    }

    function validCountry(c) {
      return c is string && (c == '' || c.matches('^[A-Z]{2}$'));
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // A counter field moves by exactly +1 / -1 compared to the stored value.
    function bumped(field, delta) {
      return changed().hasOnly([field])
        && request.resource.data[field] == resource.data[field] + delta;
    }

    // `lastField` was older than `minutes` (or never set) and this batch sets it to now.
    function cooledDown(lastField, minutes) {
      let before = get(userPath(request.auth.uid)).data;
      let after = getAfter(userPath(request.auth.uid)).data;
      return after.get(lastField, null) == request.time
        && (before.get(lastField, null) == null
            || before[lastField] < request.time - duration.value(minutes, 'm'));
    }

    // ---------- anti-abuse ----------

    // UTC day as an int, e.g. 20261112. The client sends the same key (src/lib/quota.ts).
    function todayKey() {
      return request.time.year() * 10000 + request.time.month() * 100 + request.time.day();
    }

    // On the user doc: a daily counter may only move to today, by +1 (or restart at 1), up to `cap`.
    function validDaily(dayField, countField, cap) {
      let oldDay = resource.data.get(dayField, 0);
      let oldCount = resource.data.get(countField, 0);
      let newDay = request.resource.data.get(dayField, 0);
      let newCount = request.resource.data.get(countField, 0);
      return newDay == todayKey()
        && newCount <= cap
        && ((oldDay == todayKey() && newCount == oldCount + 1)
            || (oldDay != todayKey() && newCount == 1));
    }

    // On a create: this batch also bumped the user's daily counter (validDaily enforces the cap).
    function countedToday(dayField, countField) {
      let before = get(userPath(request.auth.uid)).data;
      let after = getAfter(userPath(request.auth.uid)).data;
      return after.get(dayField, 0) == todayKey()
        && (before.get(dayField, 0) != todayKey()
            || after.get(countField, 0) == before.get(countField, 0) + 1);
    }

    function isBuilderAfter() {
      return getAfter(userPath(request.auth.uid)).data.role in ['builder', 'both'];
    }

    // Public lists are paged: nobody can pull a whole collection in one request.
    function smallPage() {
      return request.query.limit != null && request.query.limit <= 50;
    }

    // Avatars come from Google only (no tracking pixels from arbitrary hosts).
    function validPhoto(p) {
      return p is string && (p == '' || p.matches('^https://lh3\\.googleusercontent\\.com/[^\\s]{1,480}$'));
    }

    // Nobody can pose as the official account.
    function reservedName(n) {
      return n.lower().trim() in ['buildthis', 'build this'];
    }

    // authorName/authorPhoto on content must match the author's own profile.
    function authorMatchesProfile(d) {
      let profile = get(userPath(request.auth.uid)).data;
      return d.authorName == profile.name && d.authorPhoto == profile.photo;
    }

    // ---------- moderation ----------
    // Reports live in `{doc}/reports/{uid}` (one per user, readable only by the reporter) and a
    // private counter in `{doc}/meta/moderation` (admins only). With REPORT_LIMIT distinct reports the
    // doc must become hidden in the same batch. Nobody else ever sees how many reports there are.

    function reportLimit() {
      return 3;
    }

    // Visible to everyone, or hidden but you're the author / an admin.
    function canSee(d) {
      return d.get('hidden', false) == false || isAdmin() || (signedIn() && d.authorId == request.auth.uid);
    }

    // Lists: the query itself must filter `hidden == false` (or only ask for your own posts).
    function canList(d) {
      return d.hidden == false || (signedIn() && d.authorId == request.auth.uid) || isAdmin();
    }

    // A report batch: own report doc created now, counter +1, and hidden once the limit is reached.
    function validReport(coll, id, uid) {
      let metaPath = /databases/$(database)/documents/$(coll)/$(id)/meta/moderation;
      let before = exists(metaPath) ? get(metaPath).data.get('reports', 0) : 0;
      let after = getAfter(metaPath).data.get('reports', 0);
      let parentAfter = getAfter(/databases/$(database)/documents/$(coll)/$(id)).data;
      return isMe(uid)
        && inGoodStanding()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.createdAt == request.time
        && after == before + 1
        && (after < reportLimit() || parentAfter.hidden == true);
    }

    // The counter doc: only ever +1 by a reporter (with their report doc), or reset by an admin.
    function validModerationWrite(coll, id) {
      let reportPath = /databases/$(database)/documents/$(coll)/$(id)/reports/$(request.auth.uid);
      return request.resource.data.keys().hasOnly(['reports'])
        && request.resource.data.reports is int
        && (isAdmin()
            || (signedIn() && !exists(reportPath) && existsAfter(reportPath)
                && request.resource.data.reports == (resource == null ? 0 : resource.data.get('reports', 0)) + 1));
    }

    // Hiding happens only in a report batch that reaches the limit, and gives the author a strike.
    // Un-hiding is admin-only (Firebase console).
    function hideByReports(coll, id) {
      let metaPath = /databases/$(database)/documents/$(coll)/$(id)/meta/moderation;
      return active() && changed().hasOnly(['hidden'])
        && request.resource.data.hidden == true
        && existsAfter(/databases/$(database)/documents/$(coll)/$(id)/reports/$(request.auth.uid))
        && getAfter(metaPath).data.get('reports', 0) >= reportLimit()
        && getAfter(strikesPath(resource.data.authorId)).data.get('lastId', '') == id;
    }

    // Strikes: how many of a user's posts were hidden by reports. Private to that user.
    // With strikeLimit() strikes they can't post, claim or report any more (voting still works).
    function deletedAuthor() {
      return isMe(resource.data.authorId)
        && changed().hasOnly(['authorName', 'authorPhoto'])
        && request.resource.data.authorName == 'Deleted user'
        && request.resource.data.authorPhoto == '';
    }

    function strikeLimit() {
      return 2;
    }

    function strikesPath(uid) {
      return /databases/$(database)/documents/strikes/$(uid);
    }

    function inGoodStanding() {
      return !exists(strikesPath(request.auth.uid))
        || get(strikesPath(request.auth.uid)).data.count < strikeLimit();
    }

    // The strike's target was visible before this batch, is hidden after it, and is by this user.
    function strikeTargetJustHidden(coll, id, uid) {
      let path = /databases/$(database)/documents/$(coll)/$(id);
      return get(path).data.get('hidden', false) == false
        && getAfter(path).data.hidden == true
        && getAfter(path).data.authorId == uid;
    }

    // ---------- users ----------

    function validProfile(d) {
      return d.keys().hasOnly(['name', 'photo', 'role', 'country', 'stack', 'link', 'lang', 'source',
                               'lastIssueAt', 'lastSolutionAt', 'onboardedAt', 'createdAt',
                               'issuesDay', 'issuesToday', 'solutionsDay', 'solutionsToday',
                               'lastIssueId', 'lastSolutionId'])
        && str(d.name, 1, 60)
        && !reservedName(d.name)
        && validPhoto(d.photo)
        && d.role in ['user', 'builder', 'both']
        && validCountry(d.country)
        && d.stack is list && d.stack.size() <= 10
        && str(d.link, 0, 200)
        && d.lang in ['en', 'el']
        && str(d.source, 0, 200)
        && d.onboardedAt is timestamp;
    }

    match /users/{uid} {
      allow read: if isMe(uid);
      allow create: if isMe(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.onboardedAt == request.time
        && !('lastIssueAt' in request.resource.data)
        && !('lastSolutionAt' in request.resource.data)
        && !request.resource.data.keys().hasAny(['issuesDay', 'issuesToday', 'solutionsDay', 'solutionsToday',
                                                 'lastIssueId', 'lastSolutionId']);
      allow update: if isMe(uid)
        && validProfile(request.resource.data)
        && !changed().hasAny(['createdAt', 'onboardedAt'])
        // `source` is fixed, except blanked when the account is deleted.
        && (!changed().hasAny(['source']) || request.resource.data.source == '')
        && str(request.resource.data.get('lastIssueId', ''), 0, 40)
        && str(request.resource.data.get('lastSolutionId', ''), 0, 200)
        // Cooldown stamps can only ever move to "now", never be backdated.
        && (!changed().hasAny(['lastIssueAt']) || request.resource.data.lastIssueAt == request.time)
        && (!changed().hasAny(['lastSolutionAt']) || request.resource.data.lastSolutionAt == request.time)
        // Max 5 problems and 3 solutions per UTC day.
        && (!changed().hasAny(['issuesDay', 'issuesToday']) || validDaily('issuesDay', 'issuesToday', 5))
        && (!changed().hasAny(['solutionsDay', 'solutionsToday']) || validDaily('solutionsDay', 'solutionsToday', 3));
      // Never deleted from the client: deleting and recreating it would reset the limits.
      // Account deletion blanks the personal fields instead (src/lib/data.ts deleteAccount).
      allow delete: if false;
    }

    match /strikes/{uid} {
      allow read: if isMe(uid);
      allow create, update: if active()
        && request.resource.data.keys().hasOnly(['count', 'lastColl', 'lastId'])
        && request.resource.data.count == (resource == null ? 0 : resource.data.count) + 1
        && request.resource.data.lastColl in ['issues', 'solutions']
        && strikeTargetJustHidden(request.resource.data.lastColl, request.resource.data.lastId, uid);
    }

    match /admins/{uid} {
      allow read: if isMe(uid);
    }

    // ---------- issues ----------

    function validIssueContent(d) {
      return str(d.title, 8, 120)
        && str(d.body, 0, 2000)
        && d.category in categories()
        && validCountry(d.country)
        && str(d.authorName, 1, 60)
        && validPhoto(d.authorPhoto);
    }

    match /issues/{issueId} {
      allow get: if canSee(resource.data);
      // Queries must filter `hidden == false`, unless they only fetch your own (or you're an admin).
      allow list: if smallPage() && canList(resource.data);

      allow create: if onboarded() && inGoodStanding()
        // Auto ids only: recreating a deleted issue's id would revive its old vote docs.
        && issueId.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['title', 'body', 'category', 'country', 'authorId',
                                                 'authorName', 'authorPhoto', 'votes', 'builders',
                                                 'solutions', 'hidden', 'createdAt'])
        && request.resource.data.hidden == false
        && validIssueContent(request.resource.data)
        && authorMatchesProfile(request.resource.data)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.votes == 0
        && request.resource.data.builders == 0
        && request.resource.data.solutions == 0
        && request.resource.data.createdAt == request.time
        && cooledDown('lastIssueAt', 10)
        && countedToday('issuesDay', 'issuesToday')
        // One create per batch: the user doc can only name one new issue.
        && getAfter(userPath(request.auth.uid)).data.get('lastIssueId', '') == issueId;

      allow update: if
        // Vote / unvote, together with the vote doc.
        (active() && bumped('votes', 1)
          && !exists(/databases/$(database)/documents/issues/$(issueId)/votes/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/issues/$(issueId)/votes/$(request.auth.uid)))
        || (active() && bumped('votes', -1)
          && exists(/databases/$(database)/documents/issues/$(issueId)/votes/$(request.auth.uid))
          && !existsAfter(/databases/$(database)/documents/issues/$(issueId)/votes/$(request.auth.uid)))
        // "I'm building this" / un-claim.
        || (active() && bumped('builders', 1)
          && !exists(/databases/$(database)/documents/issues/$(issueId)/builders/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/issues/$(issueId)/builders/$(request.auth.uid)))
        || (signedIn() && bumped('builders', -1)
          && exists(/databases/$(database)/documents/issues/$(issueId)/builders/$(request.auth.uid))
          && !existsAfter(/databases/$(database)/documents/issues/$(issueId)/builders/$(request.auth.uid)))
        // Solution submitted / removed (solution id is `${issueId}_${uid}`).
        || (active() && bumped('solutions', 1)
          && !exists(/databases/$(database)/documents/solutions/$(issueId + '_' + request.auth.uid))
          && existsAfter(/databases/$(database)/documents/solutions/$(issueId + '_' + request.auth.uid)))
        || (active() && bumped('solutions', -1)
          && exists(/databases/$(database)/documents/solutions/$(issueId + '_' + request.auth.uid))
          && !existsAfter(/databases/$(database)/documents/solutions/$(issueId + '_' + request.auth.uid)))
        // Admin removing someone's solution keeps the counter right.
        || (isAdmin() && bumped('solutions', -1))
        // Author edits content.
        || (isMe(resource.data.authorId) && inGoodStanding()
          && changed().hasOnly(['title', 'body', 'category', 'country', 'authorName', 'authorPhoto'])
          && validIssueContent(request.resource.data)
          && authorMatchesProfile(request.resource.data))
        // Account deletion relabels authored content (allowed even when blocked).
        || deletedAuthor()
        // Moderation.
        || hideByReports('issues', issueId)
        || (isAdmin() && changed().hasOnly(['hidden']));

      allow delete: if isAdmin();

      match /reports/{uid} {
        allow read: if isMe(uid) || isAdmin();
        allow create: if validReport('issues', issueId, uid);
      }

      match /meta/{docId} {
        allow read: if isAdmin();
        allow create, update: if docId == 'moderation' && validModerationWrite('issues', issueId);
      }

      // Vote / builder docs are keyed by uid: one per user. The counter must move in the same batch.
      match /votes/{uid} {
        allow read: if isMe(uid);
        allow create: if isMe(uid) && inGoodStanding()
          && request.resource.data.keys().hasOnly(['uid', 'issueId', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.issueId == issueId
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/issues/$(issueId)).data.votes
             == get(/databases/$(database)/documents/issues/$(issueId)).data.votes + 1;
        allow delete: if isMe(uid) && inGoodStanding()
          && getAfter(/databases/$(database)/documents/issues/$(issueId)).data.votes
             == get(/databases/$(database)/documents/issues/$(issueId)).data.votes - 1;
      }

      match /builders/{uid} {
        allow read: if isMe(uid);
        // Claiming is builder-only (the client flips a plain user to 'both' in the same batch).
        allow create: if onboarded() && isMe(uid) && isBuilderAfter() && inGoodStanding()
          && request.resource.data.keys().hasOnly(['uid', 'issueId', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.issueId == issueId
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/issues/$(issueId)).data.builders
             == get(/databases/$(database)/documents/issues/$(issueId)).data.builders + 1;
        allow delete: if isMe(uid)
          && getAfter(/databases/$(database)/documents/issues/$(issueId)).data.builders
             == get(/databases/$(database)/documents/issues/$(issueId)).data.builders - 1;
      }
    }

    // ---------- solutions ----------

    function validSolutionContent(d) {
      return str(d.title, 2, 80)
        && str(d.url, 10, 300) && d.url.matches('^https://[^\\s]+$')
        && str(d.body, 0, 1000)
        && str(d.authorName, 1, 60)
        && validPhoto(d.authorPhoto);
    }

    match /solutions/{solutionId} {
      allow get: if canSee(resource.data);
      allow list: if smallPage() && canList(resource.data);

      allow create: if onboarded() && inGoodStanding()
        && solutionId == request.resource.data.issueId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['issueId', 'title', 'url', 'body', 'authorId',
                                                 'authorName', 'authorPhoto', 'votes', 'hidden', 'createdAt'])
        && request.resource.data.hidden == false
        && validSolutionContent(request.resource.data)
        && authorMatchesProfile(request.resource.data)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.votes == 0
        && request.resource.data.createdAt == request.time
        // One create per batch (see issues).
        && getAfter(userPath(request.auth.uid)).data.get('lastSolutionId', '') == solutionId
        && exists(/databases/$(database)/documents/issues/$(request.resource.data.issueId))
        && getAfter(/databases/$(database)/documents/issues/$(request.resource.data.issueId)).data.solutions
           == get(/databases/$(database)/documents/issues/$(request.resource.data.issueId)).data.solutions + 1
        && cooledDown('lastSolutionAt', 2)
        && countedToday('solutionsDay', 'solutionsToday')
        && isBuilderAfter()
        // Claim first ("I'm building this"), then wait an hour: stops scripted drive-by submissions.
        && exists(/databases/$(database)/documents/issues/$(request.resource.data.issueId)/builders/$(request.auth.uid))
        && get(/databases/$(database)/documents/issues/$(request.resource.data.issueId)/builders/$(request.auth.uid)).data.createdAt
           < request.time - duration.value(60, 'm');

      allow update: if
        (isMe(resource.data.authorId) && inGoodStanding()
          && changed().hasOnly(['title', 'url', 'body', 'authorName', 'authorPhoto'])
          && validSolutionContent(request.resource.data)
          && authorMatchesProfile(request.resource.data))
        || (active() && bumped('votes', 1)
          && !exists(/databases/$(database)/documents/solutions/$(solutionId)/votes/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/solutions/$(solutionId)/votes/$(request.auth.uid)))
        || (active() && bumped('votes', -1)
          && exists(/databases/$(database)/documents/solutions/$(solutionId)/votes/$(request.auth.uid))
          && !existsAfter(/databases/$(database)/documents/solutions/$(solutionId)/votes/$(request.auth.uid)))
        || deletedAuthor()
        // Moderation.
        || hideByReports('solutions', solutionId)
        || (isAdmin() && changed().hasOnly(['hidden']));

      // Author or admin removes a solution; the issue counter goes down in the same batch
      // (or the issue itself is already gone).
      allow delete: if ((isMe(resource.data.authorId) && inGoodStanding()) || isAdmin())
        && (!exists(/databases/$(database)/documents/issues/$(resource.data.issueId))
            || getAfter(/databases/$(database)/documents/issues/$(resource.data.issueId)).data.solutions
               == get(/databases/$(database)/documents/issues/$(resource.data.issueId)).data.solutions - 1);

      match /reports/{uid} {
        allow read: if isMe(uid) || isAdmin();
        allow create: if validReport('solutions', solutionId, uid);
      }

      match /meta/{docId} {
        allow read: if isAdmin();
        allow create, update: if docId == 'moderation' && validModerationWrite('solutions', solutionId);
      }

      match /votes/{uid} {
        allow read: if isMe(uid);
        allow create: if isMe(uid) && inGoodStanding()
          && request.resource.data.keys().hasOnly(['uid', 'solutionId', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.solutionId == solutionId
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/solutions/$(solutionId)).data.votes
             == get(/databases/$(database)/documents/solutions/$(solutionId)).data.votes + 1;
        allow delete: if isMe(uid) && inGoodStanding()
          && getAfter(/databases/$(database)/documents/solutions/$(solutionId)).data.votes
             == get(/databases/$(database)/documents/solutions/$(solutionId)).data.votes - 1;
      }
    }

    // "My votes" on /me and own claims (account deletion): collection-group queries, own docs only.
    match /{path=**}/votes/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /{path=**}/builders/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
