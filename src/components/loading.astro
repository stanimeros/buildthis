---
// Fallback shown while a client-only island loads. Matches the React <Spinner />.
---

<div class="flex justify-center py-24" role="status" aria-live="polite">
  <div class="flex gap-1.5">
    <span class="size-2.5 animate-bounce rounded-full bg-primary"></span>
    <span class="size-2.5 animate-bounce rounded-full bg-primary [animation-delay:120ms]"></span>
    <span class="size-2.5 animate-bounce rounded-full bg-primary [animation-delay:240ms]"></span>
  </div>
</div>
