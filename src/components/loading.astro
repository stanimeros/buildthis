---
// Fallback shown while a client-only island loads. Same markup as <Spinner /> in spinner.tsx.
const delays = ['', '[animation-delay:120ms]', '[animation-delay:240ms]']
---

<div class="flex justify-center py-24 text-primary" role="status" aria-live="polite">
  <span aria-hidden="true" class="inline-flex items-center gap-[0.3em] py-[0.4em] text-[25px]">
    {delays.map((d) => <span class:list={['size-[0.4em] animate-dot rounded-full bg-current', d]} />)}
  </span>
</div>
