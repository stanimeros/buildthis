---
export { getStaticPaths } from '@/i18n'
import Base from '@/layouts/base.astro'
import HomeIsland from '@/islands/home'

const lang = Astro.params.lang === 'el' ? 'el' : 'en'
---

<!-- Pre-rendered at build time (SEO), then hydrated for motion and live data. -->
<Base titleKey="meta.home">
  <HomeIsland client:load lang={lang} />
</Base>
