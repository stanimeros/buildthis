---
// Sonner injects its CSS into <head> at runtime, which <ClientRouter /> swaps out on navigation.
import 'sonner/dist/styles.css'
import '@/index.css'

import { ClientRouter } from 'astro:transitions'

import i18n, { langFromPath, localizePath } from '@/i18n'
import FooterIsland from '@/islands/footer'
import HeaderIsland from '@/islands/header'

interface Props {
  /** i18n key for the tab title (src/i18n/locales) */
  titleKey: string
  /** i18n key for the meta description */
  descriptionKey?: string
  /** Pages served for many URLs (rewrites) or private pages. */
  noindex?: boolean
}

const { titleKey, descriptionKey = 'meta.description', noindex = false } = Astro.props
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/')
const lang = langFromPath(path)
const t = i18n.getFixedT(lang)
const fullTitle = titleKey === 'meta.home' ? t(titleKey) : `${t(titleKey)} · BuildThis`
const description = t(descriptionKey)
const url = (l: 'en' | 'el') => new URL(localizePath(path, l), Astro.site).href
const canonical = url(lang)
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f8f5ee" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://firestore.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://www.gstatic.com" />
    <!-- Back to the language this visitor picked before, or Greek for a Greek browser on a first
         visit. Crawlers have neither, so they index both versions as they are. -->
    <script is:inline>
      ;(() => {
        const path = location.pathname
        const here = /^\/el(?=\/|$)/.test(path) ? 'el' : 'en'
        let want = null
        try {
          want = localStorage.getItem('lang')
        } catch {}
        if (want !== 'en' && want !== 'el') want = navigator.languages?.some((l) => /^el\b/i.test(l)) ? 'el' : null
        if (!want || want === here) return
        const bare = path.replace(/^\/el(?=\/|$)/, '') || '/'
        const to = want === 'en' ? bare : bare === '/' ? '/el' : `/el${bare}`
        location.replace(to + location.search + location.hash)
      })()
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="en" href={url('en')} />
          <link rel="alternate" hreflang="el" href={url('el')} />
          <link rel="alternate" hreflang="x-default" href={url('en')} />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BuildThis" />
    <meta property="og:locale" content={lang === 'el' ? 'el_GR' : 'en_US'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <ClientRouter />
    <!-- An <AuthLink> clicked before its island has hydrated would just follow its href (and land on
         "Sign in to continue"). Hold the click until the auth dialog in the header picks it up. -->
    <script is:inline>
      if (!window.__authLinkGuard) {
        window.__authLinkGuard = true
        document.addEventListener(
          'click',
          (e) => {
            const a = e.target instanceof Element && e.target.closest('a[data-auth-link]')
            if (!a || !a.closest('astro-island[ssr]')) return
            e.preventDefault()
            window.__pendingAuthLink = a.getAttribute('href')
            window.dispatchEvent(new Event('buildthis:auth-link'))
          },
          true,
        )
      }
    </script>
  </head>
  <body class="flex min-h-svh flex-col overflow-x-clip bg-background text-foreground">
    <HeaderIsland client:load transition:persist="header" lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <FooterIsland client:load transition:persist="footer" lang={lang} />
  </body>
</html>
