{
  "hosting": {
    "site": "buildthis-stanimeros",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/p/*/edit",
        "destination": "/problem-edit.html"
      },
      {
        "source": "/p/*/submit",
        "destination": "/problem-submit.html"
      },
      {
        "source": "/p/*",
        "destination": "/problem.html"
      }
    ],
    "headers": [
      {
        "source": "/_astro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/issues",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/issues/:rest*",
        "destination": "/p/:rest*",
        "type": 301
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
