# Copy to .env.local and fill in from Firebase console → Project settings → Your apps (Web)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=buildthis-stanimeros.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=buildthis-stanimeros
PUBLIC_FIREBASE_STORAGE_BUCKET=buildthis-stanimeros.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional: reCAPTCHA Enterprise site key for App Check (leave empty to disable)
PUBLIC_RECAPTCHA_ENTERPRISE_KEY=

# i18n-sync (translation CLI)
GEMINI_API_KEY=
