# Copy to .env.local and fill in from Firebase console → Project settings → Your apps (Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=buildthis-stanimeros.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=buildthis-stanimeros
VITE_FIREBASE_STORAGE_BUCKET=buildthis-stanimeros.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: reCAPTCHA Enterprise site key for App Check (leave empty to disable)
VITE_RECAPTCHA_ENTERPRISE_KEY=

# i18n-sync (translation CLI)
GEMINI_API_KEY=
