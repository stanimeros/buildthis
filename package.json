{
  "name": "buildthis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "tsc --noEmit && astro build",
    "lint": "oxlint",
    "preview": "astro preview",
    "test:rules": "firebase emulators:exec --only firestore --project demo-buildthis 'node --test tests/'",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-buildthis",
    "dev:local": "PUBLIC_USE_EMULATORS=1 PUBLIC_FIREBASE_PROJECT_ID=demo-buildthis astro dev",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.8",
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "astro": "^7.4.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "firebase": "^13.3.0",
    "i18next": "^27.1.1",
    "motion": "^14.12.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
