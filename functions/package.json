{
  "name": "functions",
  "private": true,
  "description": "BuildThis Cloud Functions: email notifications",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "npm run typecheck && npm run build && firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.0.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
